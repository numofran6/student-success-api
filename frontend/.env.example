# Set to true to run the whole frontend on realistic sample data, with no
# sign-in and no backend required — handy for reviewing the UI before the
# real backend is ready. Set to false (or remove) once you want to connect
# to the real backend.
NEXT_PUBLIC_DEMO_MODE=false

# Base URL of the NestJS Student Success API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4001

# No auth config needed here — this app uses a shared-password gate.
# The password itself lives only in the backend's API_KEY env var; whoever
# uses this app is told the password out of band and types it into the
# login screen.
