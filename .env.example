# App
PORT=4001

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/student_success
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true

# Shared staff access password. Checked against the X-API-Key header on
# every request. Whoever's using the frontend types this value into the
# login screen — it isn't stored in the frontend's env.
API_KEY=change-me

# Python analytics service (classical ML + deep learning models)
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_API_KEY=
