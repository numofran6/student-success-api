# App
PORT=4001

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/student_success
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true

# Secret used to sign staff session tokens (JWT) issued on login/signup.
# Generate one with `openssl rand -hex 32`. Changing it invalidates every
# existing session.
JWT_SECRET=change-me

# Python analytics service (classical ML + deep learning models)
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_API_KEY=

# Comma-separated allowed origins for CORS (e.g. https://your-app.vercel.app).
# Leave blank to allow any origin — fine for local development, not for a
# real deployment.
CORS_ORIGIN=
